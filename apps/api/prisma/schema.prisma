/// "native" = Windows local (dev); "debian-openssl-3.0.x" = Linux containers como
/// Render/Railway. Sem o segundo, o build gerado localmente não roda no servidor.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PSICOLOGO_TITULAR
  SECRETARIA
  SUPERVISOR
  PACIENTE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// CLINICA = tenant com paciente/prontuário/agenda ativos, exige psicólogo com
/// CRP verificado. ESTUDANTE = conta só para comprar/estudar curso avulso no
/// Marketplace — mesmo sistema de auth, sem acesso a nenhum módulo clínico.
enum TenantKind {
  CLINICA
  ESTUDANTE
}

enum CrpStatus {
  NAO_ENVIADO
  EM_ANALISE
  VERIFICADO
  REJEITADO
}

/// Verificação de matrícula de estudante de psicologia (item 4) — mesmos 4
/// estados do CrpStatus, enum separado de propósito (semântica diferente,
/// nunca deve ser confundido com verificação de CRP de psicólogo titular).
enum StudentVerificationStatus {
  NAO_ENVIADO
  EM_ANALISE
  VERIFICADO
  REJEITADO
}

/// Gate independente do CrpStatus — CRP já é verificado no cadastro do
/// assinante (CLINICA), então checar de novo seria redundante aqui. Isto
/// aprova especificamente a ATUAÇÃO como supervisor na plataforma (decisão
/// do admin, não do titular que cria a conta). Null = não é candidato a
/// supervisor (role != SUPERVISOR).
enum SupervisorApprovalStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

/// Mesmos 4 estados de CrpStatus/StudentVerificationStatus, enum separado de
/// propósito — nunca deve ser confundido com verificação de CRP. Rege o
/// vídeo de apresentação do Site Profissional (Tenant.presentationVideo*):
/// só o admin da plataforma pode levar pra PUBLICADO, nunca o profissional
/// diretamente — mitiga risco de conteúdo que viole o código de ética do CRP
/// ir ao ar sem revisão.
enum VideoApprovalStatus {
  NAO_ENVIADO
  EM_ANALISE
  PUBLICADO
  REJEITADO
}

/// Público-alvo do curso (Course.audience) — decide quem enxerga acesso via
/// CoursesService.hasModuleAccess: ESTUDANTES é o modo clássico (só
/// tenant.kind=ESTUDANTE, via compra na Loja/Marketplace, nunca CLINICA).
/// PROFISSIONAIS_GRATIS/PROFISSIONAIS_PAGO são exclusivos de tenant.kind=
/// CLINICA — GRATIS ainda exige o gate de AccessGateService (CRP+assinatura+
/// termos), "grátis" aqui significa "incluso na assinatura", nunca "livre
/// pra qualquer um"; PAGO exige o mesmo gate MAIS uma CourseEnrollment (ver
/// MarketplaceService.enroll, que já funciona pra qualquer tenant.kind sem
/// mudança). Default ESTUDANTES preserva o comportamento de cursos já
/// cadastrados antes desta mudança.
enum CourseAudience {
  ESTUDANTES
  PROFISSIONAIS_GRATIS
  PROFISSIONAIS_PAGO
}

enum EnrollmentSource {
  ASSINATURA
  MARKETPLACE
}

enum LeadStage {
  NOVO
  CONTATADO
  AGENDADO
  CONVERTIDO
  PERDIDO
}

/// Um tenant = uma conta de psicólogo(a)/clínica OU uma conta individual de
/// estudante (ver TenantKind). Toda tabela clínica carrega tenantId e é
/// protegida por Row-Level Security (ver prisma/rls.sql).
model Tenant {
  id   String     @id @default(uuid())
  name String
  slug String     @unique
  kind TenantKind @default(CLINICA)

  /// Sub-conta no gateway de pagamento nacional (ex: Asaas) que recebe
  /// diretamente os pagamentos de pacientes ao psicólogo — ver Invoice.
  /// A plataforma nunca retém esse dinheiro, então não é responsável por
  /// declarar ganhos/impostos do assinante.
  payoutProvider  String?
  payoutAccountId String?

  /// Conteúdo do Site Profissional (página pública em /p/{slug}). Não tem RLS
  /// de propósito — GET público não passa por AuthMiddleware, então nunca há
  /// app.tenant_id setado nessa rota; ver profile.service.ts.
  /// Apresentação pessoal, curta — usada no topo (hero) da página pública.
  bio            String?
  /// Descrição de como funciona o atendimento (método, formato, o que esperar)
  /// — usada na seção "Sobre o atendimento", separada do bio pra não repetir
  /// o mesmo texto duas vezes na página.
  attendanceInfo String?
  photoUrl       String?
  specialties    String?
  publicEmail    String?
  publicPhone    String?
  /// Endereço físico da clínica — mostrado no Site Profissional e no
  /// cabeçalho/rodapé (texto) dos documentos gerados, junto com telefone/
  /// e-mail (ver psych-document-pdf-renderer.ts).
  publicAddress  String?
  /// Cidade/UF separados do endereço — mostrados como selo ao lado do nome
  /// no Site Profissional, mesmo sem endereço físico preenchido (útil pra
  /// quem atende só online).
  publicCity     String?
  publicState    String?

  /// Redes sociais — cada uma é 100% opcional; só aparece no Site
  /// Profissional quando preenchida (mesmo padrão de publicEmail/publicPhone,
  /// sem flag de habilitar/desabilitar separada: o campo vazio já é "desligado").
  socialInstagram   String?
  socialYoutube     String?
  socialFacebook    String?
  socialLinkedin    String?
  socialTiktok      String?
  /// Chave de uma paleta fixa (ver apps/web/lib/site-palettes.ts) — escolhida
  /// pelo psicólogo, aplicada só na página pública (/p/{slug}), nunca no
  /// dashboard interno. Lista fechada de propósito, validada no DTO.
  colorPalette      String  @default("salvia")
  published         Boolean @default(false)
  /// Opt-in separado de `published`: um psicólogo pode ter a página própria no
  /// ar (/p/{slug}) sem querer aparecer na busca pública agregada da home da
  /// plataforma (/profissionais) — ver DirectoryService. Falso por padrão.
  listedInDirectory Boolean @default(false)

  /// Preço fixo da sessão, em centavos — exibido na página pública (Site
  /// Profissional) só quando preenchido, e usado pra gerar o Invoice
  /// automaticamente no agendamento público (ver AvailabilitySlot). Null
  /// enquanto o psicólogo não configurar.
  sessionPriceCents Int?
  /// Liga/desliga o widget de agendamento público na página /p/{slug}. Fica
  /// falso por padrão mesmo com horários liberados, pra evitar expor a função
  /// antes do psicólogo confirmar que quer aceitar reservas com cobrança.
  bookingEnabled    Boolean @default(false)

  /// Vídeo de apresentação do Site Profissional — hospedado pelo próprio
  /// profissional no YouTube como "não listado" (não indexado, só quem tem o
  /// link acessa). O profissional só CADASTRA o link (fica em EM_ANALISE),
  /// mas só o admin da plataforma PUBLICA (nunca o próprio profissional, nem
  /// automaticamente) — ver AdminService e ProfileService.getPublic. Cadastrar
  /// outro link sobrescreve o anterior e volta pra EM_ANALISE, limpando uma
  /// rejeição anterior. Sem upload/armazenamento de arquivo no servidor —
  /// nunca gerenciamos o vídeo em si, só o link e o status de aprovação.
  presentationVideoUrl             String?
  presentationVideoStatus          VideoApprovalStatus @default(NAO_ENVIADO)
  presentationVideoRejectionReason String?

  /// Configuração PRIVADA (nunca exposta no Site Profissional) — até 5 modelos
  /// de mensagem de WhatsApp que o titular pré-programa em /dashboard/conta,
  /// usados pelo botão de WhatsApp na listagem/detalhe de pacientes
  /// (WhatsAppButton.tsx). Array de `{label, text}`, `text` pode conter o
  /// placeholder literal "{nome}", substituído pelo nome do paciente na hora
  /// de exibir (ver lib/whatsapp.ts). Null enquanto o titular não configurar
  /// — o frontend cai nos 5 modelos padrão embutidos no código nesse caso.
  whatsappTemplates Json?

  createdAt DateTime @default(now())

  users               User[]
  patients            Patient[]
  prontuarioEntries   ProntuarioEntry[]
  homeworks           Homework[]
  appointments        Appointment[]
  availabilitySlots   AvailabilitySlot[]
  invoices            Invoice[]
  subscription        Subscription?
  enrollments         CourseEnrollment[]
  testAssignments     TestAssignment[]
  psychDocuments      PsychDocument[]
  anamneseEntries     AnamneseEntry[]
  moduleProgress      ModuleProgress[]
  certificates        Certificate[]
  courseQuizAttempts  CourseQuizAttempt[]
  pushSubscriptions   PushSubscription[]
  supervisionSessions SupervisionSession[]
  supervisionMessages SupervisionMessage[]
  leads               Lead[]
  leadActivities      LeadActivity[]
  communityPosts      CommunityPost[]
  communityReplies    CommunityReply[]
  aiUsageLogs         AiUsageLog[]
  siteComments        SiteComment[]
  siteLikes           SiteLike[]
  siteProfileBlocks   SiteProfileBlock[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())

  /// Verificação real de e-mail exigida na aquisição (cadastro do plano
  /// free) — link enviado via Resend logo após o signup. Null enquanto não
  /// confirmado; não bloqueia o uso do app, só fica pendente (mesmo padrão
  /// não-bloqueante do banner de CRP/estudante). Token de uso único, expira
  /// em 24h (ver AuthService.verifyEmail); limpo depois de confirmado.
  emailVerifiedAt            DateTime?
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?

  /// "Esqueci minha senha" — token de uso único, expira em 1h (mais curto
  /// que a verificação de e-mail, porque este dá acesso à conta). Ver
  /// AuthService.requestPasswordReset/resetPassword.
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  /// Só relevante para role=PSICOLOGO_TITULAR num tenant kind=CLINICA. Rotas
  /// clínicas (Prontuário, Agenda, Teleconsulta) devem checar
  /// crpStatus=VERIFICADO antes de liberar acesso — estudante nunca atende.
  /// Ainda NÃO é checado em nenhum guard (ver README) — o fluxo de submissão/
  /// aprovação existe, mas bloquear acesso é uma decisão separada em aberto.
  crpNumber          String?
  crpStatus          CrpStatus @default(NAO_ENVIADO)
  /// Caminho local do documento enviado para análise (uploads/crp/, fora do
  /// diretório público) — ver users/crp.controller.ts. Nunca exposto direto
  /// por URL; só baixável pelo próprio titular ou pelo admin da plataforma.
  crpDocumentPath    String?
  /// Preenchido pelo admin ao rejeitar — mostrado pro psicólogo no banner de
  /// pendências pra ele saber o que corrigir antes de reenviar.
  crpRejectionReason String?

  /// Só setado quando role=SUPERVISOR (ver UsersService.createTeamMember).
  /// Enquanto não for APROVADO pelo admin da plataforma, este usuário não
  /// pode ser escolhido como supervisorId em SupervisionSession (ver
  /// SupervisionService.create). Acesso como supervisionado (superviseeId)
  /// é livre para qualquer psicólogo assinante, sem gate nenhum.
  supervisorApprovalStatus  SupervisorApprovalStatus?
  supervisorRejectionReason String?

  /// Imagem única (assinatura manuscrita + carimbo com nome/CRP, opcionalmente
  /// com timbre da clínica) usada ao gerar laudo/relatório/atestado/declaração/
  /// encaminhamento/parecer — ver PsychDocument e users/signature-upload.config.
  signatureImagePath String?

  /// Só relevante para tenant.kind=ESTUDANTE (estudante de psicologia) — item
  /// 4. Curso pago fica bloqueado (ver CoursesService.hasModuleAccess) até
  /// studentVerificationStatus=VERIFICADO. studentVerificationNote guarda a
  /// justificativa da IA (aprovação/encaminhamento) ou o motivo de rejeição
  /// do admin — nunca os dois ao mesmo tempo (sobrescrito a cada tentativa).
  studentInstitution        String?
  studentEnrollmentNumber   String?
  studentDocumentPath       String?
  studentVerificationStatus StudentVerificationStatus @default(NAO_ENVIADO)
  studentVerificationNote   String?

  prontuarioEntries               ProntuarioEntry[]       @relation("AutorEntry")
  psychDocumentsAuthored          PsychDocument[]
  anamneseEntriesAuthored         AnamneseEntry[]
  documentAcceptances             DocumentAcceptance[]
  testsAssigned                   TestAssignment[]        @relation("TestAssignedBy")
  testsCorrected                  TestAssignment[]        @relation("TestCorrectedBy")
  testsAppliedLive                TestAssignment[]        @relation("TestAppliedBy")
  moduleProgress                  ModuleProgress[]
  certificates                    Certificate[]
  courseQuizAttempts              CourseQuizAttempt[]
  supervisionsGiven               SupervisionSession[]    @relation("Supervisor")
  supervisionsReceived            SupervisionSession[]    @relation("Supervisee")
  supervisionMessagesAsSupervisor SupervisionMessage[]    @relation("SupervisionMessageSupervisor")
  supervisionMessagesAsSupervisee SupervisionMessage[]    @relation("SupervisionMessageSupervisee")
  supervisionMessagesSent         SupervisionMessage[]    @relation("SupervisionMessageSender")
  assignedLeads                   Lead[]                  @relation("LeadAssignee")
  leadActivities                  LeadActivity[]
  communityPosts                  CommunityPost[]
  communityReplies                CommunityReply[]
  communityReports                CommunityReport[]
  communityLikes                  CommunityLike[]
  communityNotifications          CommunityNotification[]
  aiUsageLogs                     AiUsageLog[]
  homeworksAssigned               Homework[]

  @@unique([tenantId, email])
  @@map("users")
}

model Patient {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  /// Nome social ou apelido — exibido no lugar do nome civil quando preenchido,
  /// sem substituir `name` (que segue sendo o nome legal usado em documentos).
  socialName String?
  email      String?
  phone      String?
  birthDate  DateTime?
  /// Paciente inativo continua com todo o histórico intacto, só some do
  /// seletor de agendamento e da listagem padrão (filtro "Ativos").
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  /// CPF/CNPJ do paciente — exigido pelo Asaas pra gerar cobrança real (ver
  /// AsaasService.createSplitCharge). Sem isso preenchido, a cobrança via
  /// Asaas é recusada com uma mensagem clara pedindo pra completar o cadastro.
  cpfCnpj String?

  /// Cliente Asaas já criado pra este paciente — reaproveitado em toda cobrança
  /// futura (mesmo padrão de Subscription.asaasCustomerId). Sem isso,
  /// createSplitCharge criava um cliente NOVO no Asaas a cada cobrança, e o
  /// Asaas rejeita a segunda tentativa com o mesmo e-mail/CPF ("já em uso") —
  /// bug real que bloqueava a 2ª sessão de qualquer paciente que já tinha
  /// agendado antes.
  asaasCustomerId String?

  /// Rascunho/anotação PRIVADA do psicólogo — mesmo padrão de Lead.notes (um
  /// campo único, sempre sobrescrito, não append-only). NUNCA deve ser
  /// selecionado em nenhum endpoint de patient-portal nem incluído em PDF
  /// entregue ao paciente — é só um guia pessoal do profissional entre
  /// sessões, diferente das entradas oficiais de ProntuarioEntry.
  privateNote String?

  /// Autoatendimento: em vez da equipe definir a senha direto (fluxo antigo,
  /// ainda existe), a equipe gera esse token e manda o link pro paciente
  /// (WhatsApp, SMS — sem infra de e-mail neste projeto). Paciente abre o
  /// link, define a própria senha (ou, se o e-mail já tiver PatientAccount
  /// de outra clínica, só confirma o vínculo — ver PatientPortalService.
  /// activate()). Token é limpo depois de usado. Expira em 48h por padrão.
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?

  /// Vínculo com a conta global do Aplicativo do Paciente (login único,
  /// cross-clínica — ver PatientAccount). Fica nulo enquanto a equipe não
  /// convida esse paciente pro portal. Autenticação passa a morar
  /// inteiramente em PatientAccount — esta linha vira só o vínculo clínico
  /// (prontuário, agendamentos, documentos) com ESTA clínica específica.
  patientAccountId String?
  patientAccount   PatientAccount? @relation(fields: [patientAccountId], references: [id])

  prontuarioEntries  ProntuarioEntry[]
  appointments       Appointment[]
  invoices           Invoice[]
  testAssignments    TestAssignment[]
  psychDocuments     PsychDocument[]
  anamneseEntry      AnamneseEntry?
  convertedFromLead  Lead?
  courseEnrollments  CourseEnrollment[]
  moduleProgress     ModuleProgress[]
  courseQuizAttempts CourseQuizAttempt[]
  certificates       Certificate[]
  homeworks          Homework[]
  pushSubscriptions  PushSubscription[]

  @@unique([tenantId, email])
  /// Evita duplicar o vínculo da mesma PatientAccount com a mesma clínica
  /// (find-or-create idempotente via upsert nesta chave — ver
  /// BookingService.createBookingForPatient). NULL não conflita com NULL em
  /// unique index do Postgres, então pacientes sem conta ainda (cadastro só
  /// pela equipe, nunca convidados pro portal) não são afetados.
  @@unique([tenantId, patientAccountId])
  @@index([tenantId])
  @@map("patients")
}

/// Conta global do Aplicativo do Paciente — um único login (e-mail+senha)
/// usado em QUALQUER clínica/profissional, sem RLS/tenantId (mesmo padrão de
/// Tenant/MeditationTrack: identidade "raiz", não dado clínico). Cada
/// relação concreta com uma clínica (prontuário, agendamentos, documentos,
/// testes) continua isolada por tenant em Patient — esta tabela só resolve
/// "quem é essa pessoa" antes de qualquer RLS entrar em cena.
model PatientAccount {
  id              String    @id @default(uuid())
  /// Sempre normalizado (lowercase+trim) em todo ponto de escrita/comparação
  /// — ver PatientPortalService/BookingService. Sem isso, "Joao@x.com" e
  /// "joao@x.com" virariam duas contas, anulando o propósito de ter uma
  /// identidade só entre clínicas.
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  cpfCnpj         String?
  birthDate       DateTime?
  createdAt       DateTime  @default(now())
  termsAcceptedAt DateTime?

  /// "Esqueci minha senha" — mesmo padrão de User.passwordResetToken.
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  patients Patient[]

  @@map("patient_accounts")
}

/// Entrada de evolução do prontuário. Nunca é editada após criada (append-only)
/// para atender a trilha de auditoria exigida pela Resolução CFP nº 06/2019.
model ProntuarioEntry {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "prontuario_tenant_fk")
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AutorEntry", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([tenantId, patientId])
  @@map("prontuario_entries")
}

/// Tarefa que o psicólogo atribui a um paciente entre sessões (ex: "escreva 3
/// situações que geraram ansiedade essa semana") — mesmo padrão de
/// TestAssignment (atribui -> paciente responde -> fica visível pro
/// psicólogo), mas sem correção/pontuação, só um texto livre de instruções e
/// uma resposta livre opcional do paciente ao marcar como feito.
model Homework {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User      @relation(fields: [assignedById], references: [id])
  title        String
  instructions String
  status       String    @default("pendente")
  dueDate      DateTime?
  /// Preenchido pelo paciente ao marcar como concluído — opcional, é só um espaço pra comentar, não uma resposta corrigível.
  patientNote  String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, patientId])
  @@map("homeworks")
}

/// Aplicativo do Paciente: token FCM de um dispositivo autorizado a receber
/// push (lembrete de consulta, dever de casa atribuído, etc). Paciente pode
/// ter vários tokens (celular + desktop) — cada um é uma linha própria,
/// removida no logout do dispositivo ou quando o FCM reporta o token inválido.
model PushSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fcmToken  String   @unique
  createdAt DateTime @default(now())

  @@index([tenantId, patientId])
  @@map("push_subscriptions")
}

model Appointment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("agendado")
  createdAt DateTime @default(now())

  /// Teleconsulta (Daily.co). `consentAt` é o consentimento informado exigido
  /// pela Resolução CFP nº 11/2018 — a sala só aparece pro paciente no
  /// Aplicativo do Paciente depois de ele registrar consentimento; ver
  /// patient-portal.service.ts.
  videoRoomUrl  String?
  videoRoomName String?
  consentAt     DateTime?

  /// Preenchido quando status vira "cancelado" ou "falta" — motivo/observação.
  cancelReason String?

  /// Trava de idempotência do lembrete de e-mail 10min antes da sessão — sem
  /// isso, o cron (roda a cada minuto) reenviaria o mesmo lembrete várias
  /// vezes enquanto startsAt continuar dentro da janela de checagem.
  reminder10MinSentAt DateTime?

  invoices         Invoice[]
  availabilitySlot AvailabilitySlot?

  @@index([tenantId, startsAt])
  @@map("appointments")
}

/// Horário que o psicólogo libera na própria Agenda pra aparecer como
/// disponível no widget de agendamento público (/p/{slug}). Existe separado
/// de Appointment porque precisa de um estado intermediário ("reservado,
/// aguardando pagamento") com prazo de expiração — Appointment sozinho não
/// tem isso. Ciclo de vida: disponivel -> reservado (visitante escolheu,
/// aguarda pagamento por 15min, ver BookingService) -> confirmado (Asaas
/// confirmou o pagamento, ver AsaasService.handleWebhook) ou de volta pra
/// disponivel (expirou sem pagar). Não há job/cron nenhum no projeto — a
/// expiração é verificada sob demanda (toda leitura de disponibilidade, ver
/// BookingService.expireStaleHolds) em vez de um worker em background.
model AvailabilitySlot {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  status    String    @default("disponivel")
  /// Só setado quando status="reservado" — se `now() > heldUntil` e ainda
  /// "reservado", a próxima leitura libera o horário de volta.
  heldUntil DateTime?
  createdAt DateTime  @default(now())

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@map("availability_slots")
}

/// Cobrança do psicólogo ao PACIENTE (Financeiro) — dinheiro vai direto para
/// Tenant.payoutAccountId no gateway nacional, nunca passa pelo caixa da
/// plataforma. Diferente de Subscription, que é o psicólogo pagando a
/// plataforma.
model Invoice {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amountCents Int
  status      String    @default("pendente")
  dueDate     DateTime
  /// Carimbado quando status vira "pago"; limpo se reverter. Base pro resumo
  /// financeiro (recebido no mês) em vez de usar dueDate como proxy.
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  /// Sessão de origem da cobrança, opcional — não obrigatório porque cobrança
  /// avulsa (ex: pacote de sessões) também é um caso real.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// Cobrança real via Asaas, com split pro payoutAccountId do Tenant — ver
  /// AsaasService.createSplitCharge. Fica null enquanto a cobrança for só o
  /// registro manual do F1 (sem gateway ligado).
  asaasPaymentId String?
  paymentLink    String?

  @@index([tenantId])
  @@map("invoices")
}

/// Catálogo de testes/escalas — GLOBAL, sem tenantId, porque é conteúdo
/// compartilhado entre todas as clínicas (como CourseVideo). Só o admin
/// da plataforma cadastra/edita (ver admin/tests.*, cadastro manual). Cada
/// template tem perguntas objetivas (múltipla escolha, usando responseScale)
/// e/ou subjetivas (texto livre, sem pontuação).
model TestTemplate {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  /// Subgrupo livre (ex: "Ansiedade", "Depressão", "Carreira") — texto, não
  /// enum, pra admin poder criar categorias novas sem mudar código.
  category      String
  source        String
  disclaimer    String
  instructions  String
  /// Escala compartilhada pelas perguntas objetivas deste template (ex: 0-3,
  /// "Nunca".."Quase todos os dias"). Perguntas subjetivas ignoram isso.
  responseScale Json?
  /// Faixas de pontuação pra SUGERIR um resultado a partir da soma das
  /// respostas objetivas SEM subescala — sempre revisável pelo psicólogo.
  scoreBands    Json?
  /// Definição das subescalas do instrumento (ex: YSQ tem 18 esquemas,
  /// Seligman tem 6 dimensões): array de { key, label, scoreBands? }. Cada
  /// TestQuestion.subscale referencia uma `key` daqui. Instrumentos simples
  /// (soma única) deixam isso null e usam scoreBands acima.
  subscales     Json?
  /// Escores compostos calculados a partir das subescalas (ex: Seligman
  /// "Total S - Total I"): array de { key, label, formula: [{ subscale,
  /// weight }], scoreBands? }. Ver scoring.ts.
  derivedScores Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  questions   TestQuestion[]
  assignments TestAssignment[]

  @@map("test_templates")
}

model TestQuestion {
  id             String       @id @default(uuid())
  testTemplateId String
  testTemplate   TestTemplate @relation(fields: [testTemplateId], references: [id], onDelete: Cascade)
  order          Int
  /// "objetiva" usa TestTemplate.responseScale (ou `options` abaixo, se
  /// preenchido); "subjetiva" é texto livre.
  type           String
  prompt         String
  /// Item de pontuação invertida (comum em escalas psicométricas reais, ex:
  /// Rosenberg) — na correção, o valor vira (min+max da escala usada) - valor
  /// escolhido, em vez de somado direto. Ver scoring.ts. Não combinar com
  /// `options` preenchido — instrumentos com opções por item (ex: HAD, BDI)
  /// já codificam a direção certa na própria ordem das opções.
  reverseScored  Boolean      @default(false)
  /// Opções específicas desta pergunta — sobrepõe TestTemplate.responseScale
  /// quando preenchido. Necessário pra escalas onde cada item tem frases de
  /// resposta próprias (ex: HAD, Beck), não uma escala Likert compartilhada.
  options        Json?
  /// Referencia uma `key` de TestTemplate.subscales — em instrumentos com
  /// múltiplas subescalas (ex: YSQ, Seligman), diz a qual dimensão este item
  /// pertence. Null = item conta pro escore geral (TestTemplate.scoreBands).
  subscale       String?

  @@index([testTemplateId])
  @@map("test_questions")
}

/// Um teste disponibilizado a um paciente específico (Aplicação de Testes).
/// Ciclo de vida: pendente (psicólogo disponibilizou, paciente ainda não
/// respondeu) -> respondido (paciente enviou; sem opção de refazer) ->
/// corrigido (psicólogo revisou/pontuou e decidiu como comunicar). O
/// paciente NUNCA vê score/resultLabel por este sistema — comunicar o
/// resultado é sempre decisão manual do psicólogo, nunca automática (mesma
/// cautela já documentada no disclaimer do GAD-7).
model TestAssignment {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testTemplateId String
  testTemplate   TestTemplate @relation(fields: [testTemplateId], references: [id])

  assignedById String
  assignedBy   User     @relation("TestAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  status String @default("pendente")

  /// Respostas brutas do paciente: { [questionId]: number | string }.
  answers                 Json?
  submittedAt             DateTime?
  /// true quando as respostas foram preenchidas pelo psicólogo durante uma
  /// aplicação ao vivo (pergunta lida em voz alta, paciente responde,
  /// profissional digita) em vez do paciente responder sozinho pela área
  /// dele — mesmas perguntas, mesmo fluxo de correção depois, só muda quem
  /// digitou. `submit` self-service continua existindo à parte (nunca
  /// removido); esta é uma segunda forma de preencher, não substitui a
  /// primeira.
  appliedLiveByStaff      Boolean   @default(false)
  appliedById             String?
  appliedBy               User?     @relation("TestAppliedBy", fields: [appliedById], references: [id])
  /// Soma automática das perguntas objetivas — só sugestão, nunca o valor
  /// final (ver finalScore/finalResultLabel).
  suggestedScore          Int?
  suggestedResultLabel    String?
  /// Escores por subescala calculados na submissão (ver scoring.ts): array
  /// de { key, label, score, resultLabel }. Só preenchido quando o template
  /// usa TestTemplate.subscales. Sempre sugestão — nunca o valor final.
  suggestedSubscaleScores Json?
  /// Escores compostos calculados na submissão a partir de derivedScores.
  suggestedDerivedScores  Json?

  finalScore        Int?
  finalResultLabel  String?
  /// Como/se o psicólogo decidiu comunicar o resultado ao paciente — nunca
  /// exibido automaticamente na área do paciente.
  communicationNote String?
  correctedAt       DateTime?
  correctedById     String?
  correctedBy       User?     @relation("TestCorrectedBy", fields: [correctedById], references: [id])

  attachedToProntuario Boolean @default(false)
  prontuarioEntryId    String?

  @@index([tenantId, patientId])
  @@map("test_assignments")
}

/// Documento psicológico preenchido pelo profissional para UM paciente
/// específico (laudo, relatório, atestado, declaração, encaminhamento ou
/// parecer — ver psych-documents/catalog). Diferente de TestAssignment: o
/// resultado aqui é entregue ao PACIENTE como PDF, mas só quando o
/// psicólogo decidir liberar (releasedToPatientAt) — gerar o documento não
/// libera sozinho, mesmo padrão de "nunca automático" já usado em
/// TestAssignment.communicationNote e Homework. Uma vez `finalizado`, o
/// PDF já gerado nunca é reeditado — qualquer correção exige um novo
/// PsychDocument (mesma disciplina de append-only do ProntuarioEntry).
model PsychDocument {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])

  /// Chave do catálogo em código (ex: "laudo", "relatorio", "atestado",
  /// "declaracao", "encaminhamento", "parecer") — ver psych-documents/catalog.
  templateSlug String
  /// Título do modelo no momento da emissão (cópia, não referência) — mantém
  /// o histórico legível mesmo se o catálogo em código mudar depois.
  title        String
  /// Conteúdo preenchido pelo psicólogo, por seção do modelo:
  /// { [sectionKey]: string }.
  fields       Json

  status      String    @default("rascunho")
  finalizedAt DateTime?
  /// PDF gerado na finalização, relativo a uploads/psych-documents/.
  filePath    String?

  /// Nunca setado automaticamente — só quando o psicólogo aciona
  /// explicitamente "Disponibilizar ao paciente".
  releasedToPatientAt DateTime?

  /// true só pro modelo "contrato" (Contrato de Prestação de Serviços
  /// Psicológicos) — o paciente vê um botão "Aceitar" em vez de só
  /// "Baixar", e o consentimento fica registrado em acceptedByPatientAt.
  requiresPatientAcceptance Boolean   @default(false)
  acceptedByPatientAt       DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, patientId])
  @@map("psych_documents")
}

/// Ficha de anamnese (entrevista/história de admissão) de UM paciente —
/// modelo escolhido por faixa etária no catálogo em código (ver
/// anamnese/catalog: "infantil"/"adolescente"/"adulto"/"idoso"). Ao
/// contrário de ProntuarioEntry/PsychDocument, é um documento interno de
/// trabalho, não append-only nem finalizado: `patientId` é único porque
/// existe UMA anamnese por paciente, sempre editável (upsert), sem
/// histórico de versões — cada salvamento sobrescreve o anterior, mesmo
/// padrão de Patient.privateNote.
model AnamneseEntry {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])

  /// Chave do catálogo em código ("infantil"/"adolescente"/"adulto"/"idoso") — ver anamnese/catalog.
  templateSlug String
  /// Conteúdo preenchido pelo psicólogo, por seção do modelo: { [sectionKey]: string }.
  fields       Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("anamnese_entries")
}

/// Compra de curso avulso (Marketplace) OU acesso liberado por já ter
/// assinatura da plataforma completa — os dois casos usam o mesmo registro
/// para o player de curso checar acesso sem se importar com a origem.
/// tenant.kind=ESTUDANTE só existe para viabilizar este modelo: aluno de
/// psicologia compra o curso sem nunca abrir Prontuário/Agenda.
/// `tenantId` continua SEMPRE preenchido (mesmo em matrícula de paciente —
/// usa o tenant da clínica dele, ver PatientCoursesService): `course_enrollments`
/// tem RLS forçado, e a policy exige "tenantId" = tenant da sessão, então
/// deixar null quebraria o INSERT. `patientId` (opcional) identifica UM
/// paciente específico dentro desse tenant; null = matrícula da conta
/// ESTUDANTE inteira (fluxo clássico). A constraint de 3 colunas evita
/// colisão entre dois pacientes DIFERENTES da mesma clínica no mesmo curso
/// (patientId real, nunca null, nesse caso) — mas não impede uma conta
/// ESTUDANTE de gerar duas linhas com patientId null pro mesmo curso; isso é
/// prevenido a nível de aplicação (upsert/findFirst antes de criar), não pelo
/// banco, já que Postgres nunca considera NULL igual a NULL numa unique.
model CourseEnrollment {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String?
  patient           Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  courseSlug        String
  course            Course           @relation(fields: [courseSlug], references: [slug])
  source            EnrollmentSource
  priceCents        Int?
  paymentProvider   String?
  externalPaymentId String?
  createdAt         DateTime         @default(now())

  @@unique([tenantId, courseSlug, patientId])
  @@index([tenantId])
  @@map("course_enrollments")
}

/// Conclusão de uma aula por um usuário OU por um paciente (mutuamente
/// exclusivos, mesmo padrão de CourseEnrollment acima) — `lessonId` referencia
/// CourseLesson (catálogo admin-gerenciável, ver Course/CourseModule/
/// CourseLesson abaixo).
model ModuleProgress {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId   String?
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime     @default(now())

  @@unique([userId, lessonId])
  @@unique([patientId, lessonId])
  @@index([tenantId])
  @@map("module_progress")
}

/// Emitido automaticamente quando um usuário OU paciente completa todas as
/// aulas obrigatórias (não-extra) de um curso (ver CoursesService). Sem RLS de
/// propósito — a verificação pública por `verificationCode` (como
/// autenticidade de diploma) não deve depender de contexto de tenant, e não
/// é dado clínico sensível. `tenantId` aqui não participa de nenhuma
/// constraint de unicidade (só referência/relatório), então pode ficar
/// preenchido com o tenant da clínica do paciente sem risco de colisão.
model Certificate {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId        String?
  patient          Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  courseSlug       String
  course           Course   @relation(fields: [courseSlug], references: [slug])
  verificationCode String   @unique @default(uuid())
  issuedAt         DateTime @default(now())
  /// PNG renderizado automaticamente (nome+curso+data+código compostos sobre
  /// o CertificateTemplate vigente no momento da emissão) — relativo a
  /// uploads/certificates/. Null se nenhum CertificateTemplate estava
  /// configurado quando o certificado foi emitido (nunca re-renderizado
  /// retroativamente se o modelo mudar depois).
  filePath         String?

  @@unique([userId, courseSlug])
  @@unique([patientId, courseSlug])
  @@map("certificates")
}

/// Modelo visual ÚNICO (singleton — sempre uma linha só) usado para renderizar
/// TODOS os certificados emitidos, de qualquer curso. Posições em % (0-100)
/// relativas às dimensões da imagem enviada; fontSize em px, ajustado
/// olhando a pré-visualização (ver CertificatesService/renderer).
model CertificateTemplate {
  id             String   @id @default(uuid())
  imagePath      String
  nameX          Float    @default(50)
  nameY          Float    @default(45)
  nameFontSize   Int      @default(48)
  courseX        Float    @default(50)
  courseY        Float    @default(58)
  courseFontSize Int      @default(28)
  dateX          Float    @default(50)
  dateY          Float    @default(70)
  dateFontSize   Int      @default(18)
  codeX          Float    @default(50)
  codeY          Float    @default(92)
  codeFontSize   Int      @default(12)
  updatedAt      DateTime @updatedAt

  @@map("certificate_template")
}

/// Catálogo de cursos — GLOBAL, sem tenantId, cadastrado só pelo admin da
/// plataforma (nunca pelo psicólogo/clínica), no modelo de plataformas
/// comerciais (Hotmart/Udemy): Curso > Módulo > Aula, com aulas extras que
/// não entram na sequência obrigatória. Assinante (Tenant.kind=CLINICA) tem
/// acesso incluso na assinatura da plataforma; quem não assina compra avulso
/// via Marketplace (CourseEnrollment) e paga `priceCents`.
model Course {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  description String
  priceCents  Int?
  /// Ver enum CourseAudience — decide quem pode acessar (CoursesService.hasModuleAccess).
  audience    CourseAudience @default(ESTUDANTES)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  modules      CourseModule[]
  enrollments  CourseEnrollment[]
  certificates Certificate[]

  @@map("courses")
}

model CourseModule {
  id       String  @id @default(uuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  /// Libera sem assinatura/matrícula — isca/lead-magnet (mesmo papel do
  /// antigo "bloco grátis").
  free     Boolean @default(false)

  lessons CourseLesson[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseLesson {
  id          String       @id @default(uuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String?
  youtubeUrl  String?
  /// Aula extra/bônus: aparece à parte, nunca bloqueia nem é bloqueada pela
  /// sequência obrigatória de quiz das aulas principais do módulo.
  isExtra     Boolean      @default(false)

  materials CourseLessonMaterial[]
  quiz      CourseQuiz?
  progress  ModuleProgress[]

  @@index([moduleId])
  @@map("course_lessons")
}

/// Material de apoio pra baixar, anexado pelo admin (apps/api/uploads/
/// course-materials/) — mesmo padrão de DocumentTemplate.
model CourseLessonMaterial {
  id       String       @id @default(uuid())
  lessonId String
  lesson   CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title    String
  filePath String

  @@index([lessonId])
  @@map("course_lesson_materials")
}

/// Quiz objetivo de uma aula. Diferente do módulo clínico de Testes: a nota
/// SEMPRE aparece pro aluno, e ele pode responder quantas vezes quiser — só
/// `required` (definido pelo admin) decide se precisa atingir
/// `passingScorePercent` antes da próxima aula não-extra do módulo abrir.
model CourseQuiz {
  id                  String       @id @default(uuid())
  lessonId            String       @unique
  lesson              CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  required            Boolean      @default(false)
  passingScorePercent Int          @default(70)

  questions CourseQuizQuestion[]
  attempts  CourseQuizAttempt[]

  @@map("course_quizzes")
}

model CourseQuizQuestion {
  id              String     @id @default(uuid())
  quizId          String
  quiz            CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order           Int
  prompt          String
  /// [{ "id": "a", "label": "..." }, ...]
  options         Json
  correctOptionId String

  @@index([quizId])
  @@map("course_quiz_questions")
}

/// Histórico completo de tentativas — nunca sobrescreve, pra sustentar
/// "responder quantas vezes desejar" com nota sempre visível.
model CourseQuizAttempt {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId    String?
  patient      Patient?   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  quizId       String
  quiz         CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      Json
  scorePercent Int
  passed       Boolean
  createdAt    DateTime   @default(now())

  @@index([tenantId, userId, quizId])
  @@map("course_quiz_attempts")
}

/// Sessão de supervisão clínica entre o psicólogo titular e um supervisor —
/// hoje só modela supervisor dentro do mesmo tenant (role=SUPERVISOR
/// cadastrado via POST /users); supervisor externo cross-tenant fica para
/// depois.
model SupervisionSession {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supervisorId  String
  supervisor    User     @relation("Supervisor", fields: [supervisorId], references: [id])
  superviseeId  String
  supervisee    User     @relation("Supervisee", fields: [superviseeId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  notes         String?
  status        String   @default("agendado")
  createdAt     DateTime @default(now())
  /// Sala Daily.co criada automaticamente ao agendar (ver
  /// SupervisionService.create/createTeleconsultaRoom) — mesmo padrão do
  /// Appointment, mas sem gate de consentAt (não é dado do paciente).
  videoRoomUrl  String?
  videoRoomName String?

  @@index([tenantId, startsAt])
  @@map("supervision_sessions")
}

/// Chat de texto entre uma dupla supervisor/supervisionado — thread contínua
/// pelo par (supervisorId, superviseeId), não presa a uma SupervisionSession
/// específica (conversa persiste entre sessões agendadas). Só pode existir
/// mensagem entre um par que já tem pelo menos uma SupervisionSession (ver
/// SupervisionService.resolvePair) — nunca DM livre entre quaisquer users.
model SupervisionMessage {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supervisorId String
  supervisor   User     @relation("SupervisionMessageSupervisor", fields: [supervisorId], references: [id])
  superviseeId String
  supervisee   User     @relation("SupervisionMessageSupervisee", fields: [superviseeId], references: [id])
  senderId     String
  sender       User     @relation("SupervisionMessageSender", fields: [senderId], references: [id])
  content      String
  createdAt    DateTime @default(now())

  @@index([tenantId, supervisorId, superviseeId, createdAt])
  @@map("supervision_messages")
}

/// Lead do funil de captação (CRM), antes de virar Patient. `convertToPatient`
/// (ver CrmService) cria o Patient de verdade e linka aqui — o histórico do
/// funil não se perde quando o lead vira paciente.
model Lead {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  contact            String?
  source             String?
  stage              LeadStage @default(NOVO)
  notes              String?
  /// Responsável pelo lead (opcional) — útil em clínica com mais de um profissional.
  assignedToId       String?
  assignedTo         User?     @relation("LeadAssignee", fields: [assignedToId], references: [id])
  convertedPatientId String?   @unique
  convertedPatient   Patient?  @relation(fields: [convertedPatientId], references: [id])
  createdAt          DateTime  @default(now())

  activities LeadActivity[]

  @@index([tenantId])
  @@index([tenantId, assignedToId])
  @@map("leads")
}

/// Histórico cronológico (append-only) de interações com o lead — diferente
/// de Lead.notes (um campo único, sempre sobrescrito, pra status atual em
/// uma linha). Cada entrada aqui fica pra sempre, registrando quem fez o quê
/// e quando (ex: "liguei, sem resposta", "remarcado pra sexta").
model LeadActivity {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
  @@map("lead_activities")
}

/// Categorias fixas do fórum — lista fechada de propósito (como LeadStage),
/// pra manter o feed organizado sem virar taxonomia livre descontrolada.
enum CommunityCategory {
  INDICACAO
  CASO_CLINICO
  GESTAO_CONSULTORIO
  ABORDAGENS_TECNICAS
  CARREIRA_FORMACAO
  GERAL
}

/// Comentário/feedback de visitante na página pública (/p/{slug}) — NUNCA
/// editável (nem pelo profissional, nem pelo admin): só existem os estados
/// abaixo, todos reversíveis, o texto em si é imutável depois de enviado.
///
/// `consentToPublish`: marcado pelo próprio visitante no envio — condição
/// necessária (mas não suficiente) pra aparecer na página pública. Sem isso,
/// o comentário é só feedback privado que o profissional pode ler mas nunca
/// publicar (ver SiteCommentsService.setPublished).
///
/// `publishedByProfessional`: decisão do profissional de mostrar ou não este
/// comentário específico na própria página — nunca pode virar true se
/// `consentToPublish` for false (validado no service, não é uma CHECK de
/// banco porque Prisma não expressa isso declarativamente).
///
/// `blockedByAdmin`/`blockedReason`: veto do admin da plataforma (violação do
/// código de ética do CRP, por exemplo) — quando true, o comentário fica
/// invisível na página pública INDEPENDENTE do que o profissional escolheu;
/// o profissional continua vendo o próprio comentário e o motivo do bloqueio
/// no painel, só não consegue revertê-lo.
///
/// Tem RLS com a exceção `__system__` (mesmo padrão de `patients`/`users`) —
/// necessário pro admin poder revisar/bloquear comentários de qualquer
/// clínica (ver AdminService), ao contrário de `leads`, que é só do próprio
/// profissional.
model SiteComment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  authorName String
  content    String

  /// 1-5, só preenchido em depoimentos importados de outra plataforma (ver
  /// `importedFrom`) — o formulário nativo do site não coleta nota.
  rating       Int?
  /// Nome da plataforma de origem (ex: "Conexa"), só setado em depoimentos
  /// importados — exibido como selo de transparência na página pública,
  /// nunca omitido pra não aparentar que veio do formulário nativo do site.
  importedFrom String?

  consentToPublish        Boolean
  publishedByProfessional Boolean @default(false)
  blockedByAdmin          Boolean @default(false)
  blockedReason           String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("site_comments")
}

/// Curtida anônima na página pública do profissional. `visitorToken` é gerado
/// no navegador do visitante (localStorage, sem conta/login associado) só pra
/// evitar curtida duplicada do mesmo aparelho — não é uma identidade real,
/// diferente de `PatientAccount`. Mesma RLS de `SiteComment` (exceção
/// `__system__`), embora hoje só o próprio profissional e o público leiam a
/// contagem; a exceção existe por consistência com o restante do domínio, não
/// por um caso de uso do admin já concreto.
model SiteLike {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorToken String
  createdAt    DateTime @default(now())

  @@unique([tenantId, visitorToken])
  @@map("site_likes")
}

/// Conteúdo repetível do Site Profissional (formação, experiência,
/// credenciais, FAQ) — mesmo padrão de PsychDocument/AnamneseEntry: a
/// ESTRUTURA de cada tipo vive em código (ver profile/block-catalog.ts),
/// o banco só guarda `type` + `fields: Json` livres. Adicionar um novo tipo
/// de bloco no catálogo nunca exige migração. `position` controla a ordem
/// de exibição na página pública, editável pelo psicólogo.
model SiteProfileBlock {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type     String
  fields   Json
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, position])
  @@map("site_profile_blocks")
}

/// Comunidade é o único espaço deliberadamente CROSS-TENANT do sistema — troca
/// de caso/indicação entre assinantes de clínicas diferentes. Por isso, ao
/// contrário de toda outra tabela, NÃO tem RLS: tenantId aqui é só atribuição
/// ("postado por qual clínica"), não isolamento. Ver prisma/rls.sql.
///
/// `authorName`/`tenantName`/`authorCrpVerified`/`authorSpecialty` são
/// snapshot de texto, não join ao vivo: `users` e `tenants` têm RLS, e uma
/// conexão sem app.tenant_id setado (o caso normal aqui, já que é leitura
/// cross-tenant) nunca conseguiria montar esse join — o Prisma erraria com
/// "Field author is required... got null". Capturados uma vez na criação,
/// quando o autor está no próprio contexto autenticado dele. Por serem
/// snapshot, um selo "CRP verificado" continua valendo mesmo se o status
/// mudar depois — reflete a situação NO MOMENTO da postagem, não ao vivo.
///
/// `removedAt`/`removedReason`: soft-delete pela moderação do admin da
/// plataforma (ver admin.service.ts) — a linha continua existindo pra
/// auditoria, só some da listagem padrão.
model CommunityPost {
  id                String            @id @default(uuid())
  /// Opcionais — null pra post institucional ("Portal do Psi", ver
  /// AdminService.createInstitutionalCommunityPost), não ligado a nenhuma
  /// clínica/usuário específico. CommunityService nunca faz include ao vivo
  /// de author/tenant (só usa os campos de snapshot authorName/tenantName),
  /// então nada mais no sistema depende desses FKs existirem.
  tenantId          String?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantName        String
  authorId          String?
  author            User?             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName        String
  authorPhotoUrl    String?
  authorCrpVerified Boolean           @default(false)
  authorSpecialty   String?
  category          CommunityCategory @default(GERAL)
  title             String
  content           String
  /// Opcional — pra posts tipo "datas comemorativas" que o psicólogo baixa e
  /// compartilha nas próprias redes. URL pública (uploads/community-images),
  /// mesmo padrão de Tenant.photoUrl (ver community-image-upload.config.ts).
  imageUrl          String?
  createdAt         DateTime          @default(now())
  removedAt         DateTime?
  removedReason     String?

  replies       CommunityReply[]
  reports       CommunityReport[]
  likes         CommunityLike[]
  notifications CommunityNotification[]

  @@index([category, createdAt])
  @@map("community_posts")
}

model CommunityReply {
  id                String        @id @default(uuid())
  postId            String
  post              CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantName        String
  authorId          String
  author            User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName        String
  authorPhotoUrl    String?
  authorCrpVerified Boolean       @default(false)
  authorSpecialty   String?
  content           String
  createdAt         DateTime      @default(now())
  removedAt         DateTime?
  removedReason     String?

  reports       CommunityReport[]
  likes         CommunityLike[]
  notifications CommunityNotification[]

  @@index([postId])
  @@map("community_replies")
}

/// Fila de denúncias pro admin da plataforma revisar — post OU resposta,
/// nunca os dois (exatamente um dos dois FKs preenchido).
model CommunityReport {
  id         String          @id @default(uuid())
  postId     String?
  post       CommunityPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId    String?
  reply      CommunityReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
  @@map("community_reports")
}

/// Curtida em post OU resposta (exatamente um dos dois FKs preenchido) — os
/// dois `@@unique` abaixo garantem no máximo uma curtida por usuário em cada
/// post/resposta (funciona mesmo com o outro campo null: Postgres nunca
/// considera dois NULLs iguais, então a constraint relevante em cada caso é
/// sempre a que tem o campo populado).
model CommunityLike {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      CommunityPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     CommunityReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, postId])
  @@unique([userId, replyId])
  @@index([postId])
  @@index([replyId])
  @@map("community_likes")
}

/// Notificação in-app (sem infra de e-mail/push neste projeto) — criada
/// quando alguém responde a um post, pro autor do post. Nunca notifica o
/// próprio autor respondendo a si mesmo.
model CommunityNotification {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     CommunityReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  message   String
  readAt    DateTime?
  createdAt DateTime        @default(now())

  @@index([userId, readAt])
  @@map("community_notifications")
}

/// Registro de cada chamada de IA (ver AiService) — existe só pra sustentar o
/// limite diário por clínica (sem isso, nenhum controle de custo existia:
/// qualquer usuário podia chamar o assistente sem limite nenhum). `feature`
/// identifica qual função gerou a chamada ('ask' | 'prontuario_summary' |
/// 'lead_followup'), tokens vêm da resposta real da Anthropic (não estimado).
model AiUsageLog {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ai_usage_logs")
}

/// Assinatura do tenant na própria plataforma (billing do Portal do Psi,
/// não confundir com Invoice, que é a cobrança do psicólogo ao paciente).
model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// Asaas é o gateway principal para assinatura da plataforma (§03 do doc de
  /// arquitetura); Stripe fica secundário, hoje só usado pelo Marketplace.
  asaasCustomerId      String?
  asaasSubscriptionId  String?
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  /// Cortesia concedida manualmente pelo admin (ex: Programa Piloto — 3
  /// meses grátis), nunca por pagamento real no Asaas. Distingue de
  /// assinatura paga no painel de receita (AdminService.getRevenueSummary)
  /// e é o que o cron de expiração de cortesias verifica antes de rebaixar
  /// `status` — sem isso, uma cortesia ficaria ativa pra sempre.
  isComplimentary      Boolean            @default(false)
  createdAt            DateTime           @default(now())

  @@map("subscriptions")
}

/// Modelo de documento (contrato, termo, recibo) enviado pelo admin —
/// apps/api/uploads/document-templates/, fora de pasta pública. Igual a
/// CourseModuleVideo, sem RLS: conteúdo global, só o admin escreve. A
/// restrição de "só assinante CLINICA vê" é feita no service de leitura
/// (DocumentTemplatesService), não no banco — mesmo padrão do bloco gratuito
/// em CoursesService.
/// Área "Contratos" no dashboard (renomeada de "Documentos" — a área nova
/// de laudo/relatório/etc. em PsychDocument herdou o nome "Documentos").
/// Modelo fixo enviado pelo admin (upload de arquivo, mesmo padrão de
/// sempre). `requiresAcceptance` marca contratos que o assinante É
/// OBRIGADO a aceitar antes de continuar usando o dashboard (ex: Termos de
/// Serviço) — ver DocumentAcceptance e o guard de aceite pendente.
/// STAFF = psicólogo/secretária/supervisor (tenant.kind=CLINICA, ver
/// AccessGateService); ESTUDANTE = quem compra curso na Loja/Marketplace.
/// Existe pra impedir que um termo de um público apareça como pendência
/// pro outro — ex: sem isso, cadastrar um "Termo de Uso do Aluno" faria
/// TODO psicólogo (que nunca vai vê-lo em lugar nenhum) ficar bloqueado
/// pra sempre no gate de acesso clínico, esperando aceitar algo que nunca
/// é exibido pra ele.
enum DocumentTemplateAudience {
  STAFF
  ESTUDANTE
}

model DocumentTemplate {
  id                 String                   @id @default(uuid())
  title              String
  description        String
  filePath           String
  requiresAcceptance Boolean                  @default(false)
  audience           DocumentTemplateAudience @default(STAFF)
  createdAt          DateTime                 @default(now())

  acceptances DocumentAcceptance[]

  @@map("document_templates")
}

/// Registro de aceite de um contrato/termo obrigatório por um usuário da
/// equipe (User) — nunca por Patient, que tem seu próprio consentimento em
/// PsychDocument.acceptedByPatientAt (área "Contrato de prestação de
/// serviços" é um PsychDocument, não um DocumentTemplate).
model DocumentAcceptance {
  id                 String           @id @default(uuid())
  documentTemplateId String
  documentTemplate   DocumentTemplate @relation(fields: [documentTemplateId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedAt         DateTime         @default(now())

  @@unique([documentTemplateId, userId])
  @@map("document_acceptances")
}

/// Biblioteca de materiais (Biblioteca no menu) — apostilas, planilhas,
/// artigos, áudios etc. em qualquer formato, organizados por categoria livre
/// (igual TestTemplate.category), enviados pelo admin e baixados pelo
/// assinante (tenant.kind=CLINICA). Mesmo padrão de storage/RLS do
/// DocumentTemplate: arquivo em apps/api/uploads/library-materials/, sem
/// RLS (conteúdo global, só admin escreve), restrição de acesso feita no
/// service de leitura (LibraryService) + EstudanteAccessGuard.
model LibraryMaterial {
  id          String   @id @default(uuid())
  category    String
  title       String
  description String?
  filePath    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("library_materials")
}

/// Trilhas de meditação/áudio guiado do app do paciente — mesmo padrão de
/// LibraryMaterial (catálogo GLOBAL, sem tenantId/RLS, só o admin cadastra),
/// mas o consumidor é o paciente (patient-portal), não a equipe. Servido por
/// download autenticado via patient JWT, não rota pública — não é conteúdo
/// sensível, mas também não há motivo pra deixar sem login nenhum.
model MeditationTrack {
  id              String   @id @default(uuid())
  category        String
  title           String
  description     String?
  audioPath       String
  durationSeconds Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@map("meditation_tracks")
}

/// Banner promocional da home pública da PLATAFORMA (/, não confundir com a
/// página do psicólogo em /p/{slug}) — só 2 posições fixas (1 e 2), geridas
/// pelo admin. Imagem fica em apps/api/uploads/banners/, servida por rota
/// pública dedicada (igual profile-photo-upload.config.ts) porque precisa
/// aparecer pra visitante sem login. Sem RLS/tenantId de propósito: conteúdo
/// global da plataforma, só o admin escreve (mesmo motivo de DocumentTemplate).
model Banner {
  id        String   @id @default(uuid())
  position  Int      @unique
  imageUrl  String
  linkUrl   String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("banners")
}

/// Singleton (sempre uma linha só, ver PlatformSettingsService) — paleta de
/// cores da plataforma em si (home pública, logins, loja de cursos, painéis
/// internos), escolhida pelo admin. Não confundir com Tenant.colorPalette,
/// que é a paleta da página individual de CADA psicólogo (/p/{slug}) — essa
/// aqui é uma escolha só, valendo pro resto do site inteiro.
model PlatformSettings {
  id           String @id @default(uuid())
  colorPalette String @default("salvia")

  /// Sobrescreve os valores padrão de apps/api/src/billing/plans.ts — null
  /// mantém o preço normal. Existe pra permitir promoção relâmpago (ex:
  /// assinar por R$1 num teste) sem precisar mexer em código/redeploy; o
  /// admin volta pro valor normal só apagando o override (ver admin/aparencia).
  subscriptionMonthlyPriceCents Int?
  subscriptionYearlyPriceCents  Int?

  /// Token efetivo do console do admin — null cai no ADMIN_TOKEN do .env
  /// (comportamento original). Preenchido pelo fluxo de "esqueci o token"
  /// (ver AdminRecoveryController), o que permite trocar o segredo em
  /// runtime sem reiniciar a API. Ver AdminTokenGuard.
  adminToken String?

  @@map("platform_settings")
}

enum CampaignLeadStatus {
  NOVO
  CONTATADO
  CONVERTIDO
  DESCARTADO
}

/// Interessado no Programa Piloto (100 psicólogos, 3 meses grátis) — nível
/// de PLATAFORMA, sem tenantId, propositalmente separado do CRM de
/// pacientes (`Lead`, que é por-tenant e pertence à clínica de cada
/// psicólogo). Captado pela página pública /programa-piloto, revisado no
/// admin; `convertedTenantId` só é preenchido depois que a pessoa faz o
/// cadastro normal em /signup e o admin concede a cortesia de 3 meses
/// (ver AdminService.grantComplimentaryTrial).
model CampaignLead {
  id                String             @id @default(uuid())
  name              String
  email             String
  phone             String
  /// Opt-in obrigatório — nunca criado sem isso (ver CampaignLeadsService.create).
  consentedAt       DateTime
  status            CampaignLeadStatus @default(NOVO)
  convertedTenantId String?
  notes             String?
  createdAt         DateTime           @default(now())

  @@map("campaign_leads")
}

enum ProspectStage {
  ENCONTRADO
  QUALIFICADO
  SELECIONADO
  CONTATO_REALIZADO
  RESPONDEU
  INTERESSADO
  CADASTRO_INICIADO
  CADASTRADO
  SEM_INTERESSE
  NAO_LOCALIZADO
  DESCARTADO
  OPT_OUT
}

/// Módulo de Prospecção Inteligente de Profissionais — nível de PLATAFORMA
/// (sem tenantId), a própria equipe do Portal do Psi buscando psicólogos que
/// ainda não são clientes. NÃO confundir com `Lead` (prospect de PACIENTE,
/// por-tenant, gerido pela clínica) nem com `CampaignLead` (captação pública
/// de interesse via formulário). Contato é sempre manual — ver
/// `ProspectingService`/`ManualCommunicationProvider`; nenhum envio
/// automático existe nesta fase.
model ProspectProfessional {
  id String @id @default(uuid())

  // Identificação
  fullName         String
  professionalName String?
  crp              String?
  city             String?
  state            String?
  country          String  @default("BR")

  // Atuação profissional
  specialties     String?
  approaches      String?
  audience        String?
  ageRange        String?
  /// presencial | online | híbrido — texto livre, mesmo padrão de Tenant.specialties.
  serviceMode     String?
  experienceNotes String?

  // Presença digital
  website           String?
  instagram         String?
  facebook          String?
  linkedin          String?
  googleBusinessUrl String?
  reviewsCount      Int?
  hasOnlineBooking  Boolean @default(false)
  hasContactForm    Boolean @default(false)

  // Contato público (nunca inferido — só o que está publicamente disponível)
  phone       String?
  whatsapp    String?
  publicEmail String?

  // Lead Score — explicável, nunca só o número (ver item 27 do spec de prospecção)
  score          Int?
  scoreBreakdown Json?
  aiSummary      String?
  aiOpportunity  String?
  aiStrategy     String?
  aiQualifiedAt  DateTime?

  // Funil/CRM
  stage             ProspectStage @default(ENCONTRADO)
  assignedToAdmin   String?
  notes             String?
  convertedTenantId String?

  /// Governança LGPD (item 19 do spec) — marcado, o prospect nunca mais
  /// aparece em listagens/seleção pra contato; dado preservado só pelo
  /// mínimo necessário pra não repetir uma abordagem indevida.
  doNotContact Boolean @default(false)

  // Proveniência — obrigatório registrar de onde veio cada dado (item 3).
  source         String?
  sourceUrl      String?
  sourceType     String?
  collectedAt    DateTime  @default(now())
  lastVerifiedAt DateTime?

  /// Hash normalizado (nome+telefone+site+instagram+cidade) — evita
  /// duplicar o mesmo profissional quando aparece em buscas diferentes
  /// (item 17 do spec); ver ProspectingService.buildDedupKey.
  dedupKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ProspectActivity[]

  @@index([stage])
  @@index([score])
  @@index([city, state])
  @@map("prospect_professionals")
}

/// Histórico cronológico (append-only) — mesmo padrão de LeadActivity.
model ProspectActivity {
  id         String               @id @default(uuid())
  prospectId String
  prospect   ProspectProfessional @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  content    String
  createdBy  String?
  createdAt  DateTime             @default(now())

  @@index([prospectId])
  @@map("prospect_activities")
}

/// Bloqueio permanente por dedupKey (item 19 do spec: "preservar apenas o
/// mínimo necessário para evitar novo contato indevido") — sobrevive mesmo
/// depois que o ProspectProfessional é removido de vez, pra que a MESMA
/// pessoa nunca seja recriada como lead "novo" numa pesquisa futura. Ver
/// AdminProspectingService.block/create.
model ProspectBlocklist {
  id        String   @id @default(uuid())
  dedupKey  String   @unique
  reason    String?
  blockedAt DateTime @default(now())

  @@map("prospect_blocklist")
}

enum ProspectSearchStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Pedido de pesquisa estruturado (item 24 do spec) — captura os critérios.
/// Execução via GoogleSearchProvider (LeadSourceProvider — item 2 do spec):
/// Google Custom Search acha candidatos, cada página é lida e a IA extrai
/// os dados estruturados, que passam pela MESMA lógica de dedup/score do
/// cadastro manual (AdminProspectingService.create) — nenhuma duplicação
/// de regra. Processado em lotes de até 10 por chamada de `execute` (ver
/// controller) pra nunca estourar timeout nem gastar cota de uma vez só.
model ProspectSearchRequest {
  id              String               @id @default(uuid())
  city            String?
  state           String?
  specialty       String?
  approach        String?
  audience        String?
  serviceMode     String?
  /// Palavras que devem aparecer na busca — texto livre, separado por vírgula.
  includeKeywords String?
  /// Palavras que devem ser evitadas — texto livre, separado por vírgula.
  excludeKeywords String?
  quantity        Int                  @default(10)
  status          ProspectSearchStatus @default(PENDENTE)
  resultCount     Int                  @default(0)
  /// Próxima posição a pedir ao Google (parâmetro `start`) — permite continuar de onde parou.
  offset          Int                  @default(0)
  notes           String?
  createdAt       DateTime             @default(now())
  completedAt     DateTime?

  @@map("prospect_search_requests")
}
